DISCORD_BOT_TOKEN=replace-with-your-discord-bot-token

# 필수 — 봇을 사용할 본인 Discord 계정 ID. 쉼표로 여러 개 등록 가능(부계정 등)
OWNER_DISCORD_ID=123456789012345678

# 필수 — 봇이 응답할 채널 ID. 쉼표로 여러 개 등록 가능
ALLOWED_CHANNEL_IDS=123456789012345678

# --- 경로 / 프로젝트 태그 (전부 선택) ---
# 프로젝트 태그(@book 등)의 상대 경로를 해석할 때 쓰는 루트.
PROJECT_ROOT=~/projects

# 프로젝트 태그 정의 TOML 경로. 기본값은 저장소 루트의 projects.toml이며,
# 파일이 없으면 프로젝트 태그 없이 정상 동작한다(하위 호환).
# projects.example.toml을 복사해 시작하라.
# PROJECTS_FILE=/path/to/projects.toml

# 잡 디렉터리(<RUNS_DIR>/job-xxxx/) 위치. 세션 저장소(~/.claudecord/sessions.json)와
# 같은 트리 아래 두는 것을 권장한다.
RUNS_DIR=~/.claudecord/runs

# 이 일수보다 오래된 잡 디렉터리를 정리한다. 0이면 정리를 끈다.
RUNS_RETENTION_DAYS=30

# claude CLI 실행 파일 경로. PATH에서 찾지 못할 때(특히 launchd/작업
# 스케줄러로 상시 구동해 PATH가 축소되는 경우) 지정한다.
# CLAUDE_BIN=/opt/homebrew/bin/claude

# --- 성능/동작 튜닝 (전부 선택. 미설정 시 아래 기본값) ---
# Claude CLI에 넘길 모델. 디스코드 요청 대부분은 sonnet으로 충분하며 가장 빠르다.
CLAUDE_MODEL=sonnet
# stream-json 한 줄의 최대 바이트. 큰 파일을 Write할 때 스트림이 끊기면 늘린다.
CLAUDE_STREAM_LIMIT_BYTES=8388608
# 작업중 GIF 첨부 여부. 켜면 첫 응답이 GIF 업로드만큼 늦어진다.
WORKING_GIF=0
# 채널별 대화 세션 유지 시간(초).
SESSION_TTL_SECONDS=3600

# --- 웜 프로세스 (매 메시지 ~1.5초 CLI 기동비 제거) ---
# 켜면 claude 프로세스를 여러 턴에 걸쳐 재사용한다. 0이면 매번 새로 띄우는 기존 방식.
# 웜 경로에서 무슨 실패가 나든 자동으로 기존 방식으로 폴백하므로, 끄는 건 문제 격리용 킬 스위치다.
WARM_CLAUDE=1
# 재사용 대기 중인 프로세스를 정리하기까지의 유휴 시간(초).
WARM_CLAUDE_IDLE_TTL_SECONDS=300
# 동시에 살려둘 유휴 프로세스 상한. 초과하면 가장 오래된 것부터 정리한다. 0이면 재사용 안 함.
WARM_CLAUDE_MAX_PROCESSES=2

# --- 잡 상한 ---
# 잡 하나의 최대 실행 시간(초). 초과하면 프로세스를 정리하고 그때까지의 부분 결과를 보낸다.
# 0 이하면 타임아웃 없음(기존 동작).
JOB_TIMEOUT_SECONDS=600
# 동시에 실행할 잡 수 상한. 초과분은 "대기 중 (앞에 N건)"으로 안내하고 순서를 기다린다.
MAX_CONCURRENT_JOBS=2

# --- 출력 ---
# 답변이 이 조각 수를 넘으면 여러 건으로 쪼개 보내는 대신 response.md 첨부 1건으로 전환한다.
# 채널당 5건/5초 레이트리밋에 걸려 마지막 조각이 늦게 도착하는 걸 막는다.
OUTPUT_INLINE_MAX_CHUNKS=3

# --- 로깅/진단 ---
# 표준 logging 레벨 이름(DEBUG/INFO/WARNING/ERROR) 중 하나. 기본값: INFO.
# 상시 구동 중 "가끔 대화가 안 이어져요" 같은 문제를 추적할 때 DEBUG로 낮춘다.
# LOG_LEVEL=INFO
# 1/true면 최종 응답 끝에 구간별 소요 시간 요약을 한 줄 덧붙인다.
# 구간 기록 자체는 항상 <job_dir>/timings.json에 남는다.
DEBUG_TIMING=0
